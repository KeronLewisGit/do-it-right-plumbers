APP_NAME="Do It Right Plumbers"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lavender-jellyfish-611595.hostingersite.com
APP_TIMEZONE=America/Los_Angeles

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u000000000_doitright
DB_USERNAME=u000000000_doitright
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
# Shared hosting has no queue worker: send email during the request.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Preview site: the temporary hostingersite.com domain has no mailbox, so emails are written to storage/logs/laravel.log.
# When the real domain is live, set MAIL_MAILER=smtp and fill in the mailbox password.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@doitrightplumbers.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@doitrightplumbers.com
MAIL_FROM_NAME="${APP_NAME}"

# Where new bookings and quote requests are emailed
COMPANY_NOTIFY_EMAIL=info@doitrightplumbers.com
COMPANY_PHONE="(714) 485-8449"
COMPANY_PHONE_HREF=+17144858449
COMPANY_SMS=+17144858449
COMPANY_EMAIL=info@doitrightplumbers.com
# COMPANY_LICENSE="CA Lic. #995611"   # already the default; set to override

VITE_APP_NAME="${APP_NAME}"
